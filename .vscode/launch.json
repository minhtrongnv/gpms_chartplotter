{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Chartplotter - Debug Serve",
            "type": "go",
            "request": "launch",
            "mode": "exec",

            "program": "${workspaceFolder}/chartplotter/bin/chartplotter-debug",
            "cwd": "${workspaceFolder}/chartplotter",

            "args": [
                "serve",
                "--assets",
                "web"
            ],

            "console": "integratedTerminal",
            "preLaunchTask": "Build Chartplotter Debug"
        }
    ]
}
